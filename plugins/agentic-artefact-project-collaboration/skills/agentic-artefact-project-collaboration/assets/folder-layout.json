      "template": "project-template/Project.md"
    },
    {
      "folder": "",
      "title": "STATUS",
      "mime_type": "application/vnd.google-apps.document",
      "template": "project-template/STATUS.md"
    },
    {
      "folder": "00_Start_Here",
      "title": "Project Index",
      "mime_type": "application/vnd.google-apps.document",
      "template": "document-templates/project-index.md"
    },
    {
      "folder": "01_Management",
      "title": "Tasks",
      "mime_type": "application/vnd.google-apps.spreadsheet",
      "template": "tasks-layout.json"
    },
    {
      "folder": "03_Deliverables",
      "title": "Deliverables",
      "mime_type": "application/vnd.google-apps.document",
      "template": "document-templates/deliverables-index.md"
    },
    {
      "folder": "04_Materials",
      "title": "Materials",
      "mime_type": "application/vnd.google-apps.document",
      "template": "document-templates/materials-index.md"
    }
